{
  "name": "hyperwood",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:biome": "biome check .",
    "check:biome:fix": "biome check --write .",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit --project api",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage --project unit --project api",
    "test:openapi": "npm run docs:lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "docs:lint": "node scripts/docs/lint.mjs",
    "docs:build": "node scripts/docs/build.mjs",
    "docs:preview": "node scripts/docs/preview.mjs",
    "docs:dev:install": "npm --prefix docs/developer install",
    "docs:dev:start": "npm --prefix docs/developer run clear && npm --prefix docs/developer run start -- --host ${DOCS_DEV_HOST:-0.0.0.0} --port ${DOCS_DEV_PORT:-3001}",
    "docs:dev:build": "npm --prefix docs/developer run build",
    "docs:dev:serve": "npm --prefix docs/developer run serve -- --host ${DOCS_DEV_HOST:-0.0.0.0} --port ${DOCS_DEV_PORT:-3001}",
    "docker:prod:up": "docker compose up --build -d",
    "docker:prod:down": "docker compose down",
    "docker:local:up": "docker compose -f docker-compose.local.yml up --build",
    "docker:local:down": "docker compose -f docker-compose.local.yml down"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "drizzle-orm": "1.0.0-beta.21",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@biomejs/biome": "^2.4.12",
    "@fastify/cors": "^11.2.0",
    "@scalar/api-reference": "^1.52.3",
    "@scalar/fastify-api-reference": "^1.52.3",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.4",
    "drizzle-kit": "1.0.0-beta.21",
    "testcontainers": "^11.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.4"
  }
}
